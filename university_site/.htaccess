# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/cp29524/apps/university_site"
PassengerBaseURI "/"
PassengerPython "/home/cp29524/virtualenv/apps/university_site/3.11/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

PassengerAppEnv production
Options -Indexes

# موبایل/اپراتورهای ایران اغلب با HTTP/3 (QUIC) مشکل دارند.
<IfModule LiteSpeed>
QuicEnable off
SpdyEnabled off
</IfModule>
<IfModule mod_headers.c>
Header always unset Alt-Svc
Header unset Alt-Svc
Header always set Alt-Svc "clear"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# صفحه تست موبایل (بدون Django)
RewriteRule ^mobile-check\.html$ - [L]

# اجبار HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^static/(.*)$ public/static/$1 [L]
RewriteRule ^media/(.*)$ public/media/$1 [L]
</IfModule>
