# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/cp29524/apps/university_site"
PassengerBaseURI "/"
PassengerPython "/home/cp29524/virtualenv/apps/university_site/3.11/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

PassengerAppEnv production
Options -Indexes

# موبایل/اپراتورهای ایران اغلب با HTTP/3 (QUIC) مشکل دارند و صفحه سفید/لودنشده می‌ماند.
<IfModule LiteSpeed>
QuicEnable off
</IfModule>
<IfModule mod_headers.c>
Header always unset Alt-Svc
Header unset Alt-Svc
Header always set Alt-Svc "clear"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# اجبار HTTPS (به‌خصوص برای موبایل و هدر امنیتی کوکی)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Map /static/ and /media/ to collectstatic/media roots (Jazzmin lives in public/static)
RewriteRule ^static/(.*)$ public/static/$1 [L]
RewriteRule ^media/(.*)$ public/media/$1 [L]
</IfModule>
