SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite | postgres | mysql
DB_ENGINE=sqlite
DB_NAME=university_db
DB_USER=university_user
DB_PASSWORD=your-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

# ایمیل — تا وقتی USER و PASSWORD هر دو پر نباشند، جنگو در حالت
# console می‌ماند و چیزی ارسال نمی‌شود (بدون هیچ خطایی).
#
# EMAIL_USE_TLS و EMAIL_USE_SSL را ننویسید: از روی پورت تعیین
# می‌شوند — ۴۶۵ یعنی SSL، ۵۸۷ یعنی TLS. دستی نوشتنِ هر دو، خطای
# «wrong version number» می‌دهد.
#
# صندوق cPanel:  EMAIL_HOST=mail.yourdomain.ir  و  EMAIL_PORT=465
#          مقدار درست را از Email Accounts ← Manage ← Connect Devices بردارید
# جیمیل:         EMAIL_HOST=smtp.gmail.com      و  EMAIL_PORT=587
#          رمز باید «رمز اپلیکیشن» باشد، نه رمز حساب
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=20

# SMS — Kavenegar (production)
SMS_ENABLED=False
# پذیرش: True = تأیید موبایل اجباری | False = موقتاً غیرفعال (مستقیم فرم)
ADMISSION_REQUIRE_MOBILE_OTP=False
KAVENEGAR_API_KEY=
# خط ارسال اختصاصی (برای OTP لازم نیست؛ برای اطلاع‌رسانی متنی لازم است)
SMS_SENDER_NUMBER=
# پیشوند پیامک‌های اطلاع‌رسانی (پذیرش، انتخاب واحد، اخبار، …)
SMS_SITE_LABEL=موسسه آموزش عالی علامه امینی
# نام الگوی تأیید در پنل کاوه‌نگار (روش پیشنهادی OTP، بدون نیاز به خط اختصاصی)
KAVENEGAR_OTP_TEMPLATE=
OTP_SEND_COOLDOWN=60
OTP_MAX_SEND_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# Payment: mock (dev) | zarinpal
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True

# Production only (cPanel)
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.ir,www.yourdomain.ir
# CSRF_TRUSTED_ORIGINS=https://yourdomain.ir,https://www.yourdomain.ir
# DB_ENGINE=mysql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
STATIC_ROOT=
MEDIA_ROOT=
