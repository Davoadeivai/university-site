# کپی روی سرور با نام: .env
# دامنه را عوض کنید. این فایل را هرگز در گیت commit نکنید.

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
DEBUG=False

# مثال: portal.yourdomain.ir
ALLOWED_HOSTS=SUBDOMAIN.YOURDOMAIN.IR
CSRF_TRUSTED_ORIGINS=https://SUBDOMAIN.YOURDOMAIN.IR

DB_ENGINE=mysql
DB_NAME=REPLACE_DB_NAME
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_HOST=localhost
DB_PORT=3306

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

SMS_ENABLED=False
KAVENEGAR_API_KEY=
SMS_SENDER_NUMBER=
SMS_SITE_LABEL=موسسه آموزش عالی علامه امینی
KAVENEGAR_OTP_TEMPLATE=
OTP_SEND_COOLDOWN=60
OTP_MAX_SEND_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# در اولین استقرار ۳۰۰ بگذارید، نه یک سال. با یک سال، اگر گواهی SSL
# خراب شود مرورگرها تا یک سال حاضر نیستند سایت را روی http باز کنند.
SECURE_HSTS_SECONDS=300

# STATIC_ROOT و MEDIA_ROOT را ننویسید تا پیش‌فرض settings_prod به کار برود.
# نوشتن‌شان به‌صورت خالی (STATIC_ROOT=) پیش‌فرض را با رشتهٔ تهی بازنویسی
# می‌کند و collectstatic فایل‌ها را جای اشتباه می‌ریزد — یا مقدار کامل
# بدهید، یا اصلاً این دو خط را نگذارید.

# ثبت‌نام دانشجو: False = باز برای همه، True = فقط پذیرفته‌شدگان
REQUIRE_ACCEPTED_APPLICATION_FOR_SIGNUP=False

# ── محدودیت نرخ ─────────────────────────────────────────────────
# شمارش روی کد ملی/شمارهٔ موبایل است، نه IP. اپراتورهای موبایل ایران
# صدها مشترک را پشت یک IP می‌گذارند؛ سقف IP-محور یعنی یک نفر بقیه را
# قفل می‌کند. ضریب زیر تعیین می‌کند سقف IP چند برابر سقف هویت باشد.
RATE_LIMIT_IP_MULTIPLIER=20
# پیش‌فرض پروژه False است — هیچ سقفی روی فرم‌های عمومی اعمال نمی‌شود.
# هزینه‌اش: کسی می‌تواند کد ملی‌ها را یکی‌یکی امتحان کند تا پروندهٔ
# پذیرش پیدا کند، و وقتی پیامک روشن شد هزاران OTP روی قبض موسسه
# بفرستد. برای برگرداندن: True
RATE_LIMIT_ENABLED=False

# ── کش مشترک بین workerها ───────────────────────────────────────
# locmem فقط برای توسعه است؛ روی سرور هر worker کش جدا می‌گیرد و
# محدودیت نرخ پیامک و جستجو بی‌اثر می‌شود.
#   database → جدول در همان دیتابیس (نیاز به createcachetable)
#   redis    → اگر Redis روی سرور هست
CACHE_BACKEND=database
CACHE_TABLE=site_cache
# REDIS_URL=redis://127.0.0.1:6379/1

# ── صف پیامک ────────────────────────────────────────────────────
# با True، ارسال از مسیر درخواست کاربر بیرون می‌رود و یک cron
# می‌فرستدشان. بدون ساختن cron این را True نکنید.
SMS_QUEUE=False

# ── بازاستفاده از اتصال دیتابیس ─────────────────────────────────
DB_CONN_MAX_AGE=60
